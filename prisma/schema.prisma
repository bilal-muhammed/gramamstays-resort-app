generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id         String   @id @default(cuid())
  guest      String
  email      String
  phone      String
  room       String
  roomNo     String
  checkIn    DateTime
  checkOut   DateTime
  nights     Int
  status     String
  amount     Float
  paidAmount Float
  payment    String
  addons     String?
  addonNote  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([guest])
  @@index([room])
}

model Room {
  id        String  @id @default(cuid())
  type      String
  floor     String
  status    String
  guest     String
  price     Float
  amenities String
  until     String?
  from      String?
  note      String?

  @@index([status])
  @@index([type])
}

model Guest {
  id         String  @id @default(cuid())
  name       String
  email      String
  phone      String
  location   String
  stays      Int
  totalSpent Float
  rating     Int
  lastStay   String
  vip        Boolean

  @@index([name])
  @@index([email])
  @@index([lastStay])
}

model Income {
  id        String   @id @default(cuid())
  date      String
  source    String
  amount    Float
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

model Expense {
  id          String   @id @default(cuid())
  date        String
  label       String
  description String
  amount      Float
  category    String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model Staff {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  role        String
  department  String
  status      String
  lastActive  String
  permissions String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([role])
  @@index([department])
  @@index([status])
}

model Activity {
  id        String   @id @default(cuid())
  time      String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Property {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Float
  status        String
  amenities     String
  image         String?
  createdAt     DateTime @default(now())
  gallery       String   @default("[]")
  badge         String   @default("")
  features      String   @default("")
  originalPrice Float    @default(0)
  rating        Float    @default(0)
  reviews       Int      @default(0)
  specs         String   @default("{}")
  tagline       String   @default("")

  @@index([name])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  phone     String
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())

  @@index([username])
  @@index([email])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  username  String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entity])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  location  String   @default("")
  rating    Int      @default(5)
  text      String
  avatar    String   @default("")
  status    String   @default("Active")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status])
  @@index([order])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  type      String   @default("general")
  status    String   @default("new")
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
